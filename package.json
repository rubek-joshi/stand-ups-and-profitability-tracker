{
  "name": "profitability-tracker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @workspace/api dev",
    "dev:web": "pnpm --filter web dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:deploy": "pnpm --filter @workspace/database db:deploy",
    "db:seed": "pnpm --filter @workspace/database db:seed",
    "db:studio": "pnpm --filter @workspace/database db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "lightningcss",
      "prisma",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "msgpackr-extract",
      "msw",
      "unrs-resolver"
    ]
  }
}
